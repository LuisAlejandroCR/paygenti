# .env.example: copy to .env.local. Every value is optional; without PayPal keys the app runs
# against an in-memory mock gateway so the judge mode works with zero setup.
PORT=8787
PUBLIC_URL=http://localhost:8787
# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: Claude for voice-to-cart and the back-office agent. Without it, a rule-based parser runs.
ANTHROPIC_API_KEY=
# Vendor PIN that unlocks refunds and payouts (demo default: 1234)
VENDOR_PIN=1234
# Ed25519 key that signs sales passports (PKCS8 PEM or base64 DER). Empty: ephemeral demo key.
# openssl genpkey -algorithm ed25519 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
PASSPORT_SIGNING_KEY=
# Postgres for sales, catalog, audit and daily caps (e.g. a Neon free project, ?sslmode=require).
# Empty: everything lives in memory and is lost on restart.
DATABASE_URL=

# Payment rails (docs/payment-rails.md). Missing config hides the rail.
# Push rails never become PAID by themselves; the vendor can confirm with her PIN (not verified).
# PIX_KEY=
# PIX_MERCHANT_NAME=
# PIX_MERCHANT_CITY=
# SPEI_CLABE=
# SPEI_BENEFICIARY=
# BREB_KEY=
# RAIL_APPLE_PAY=1
# RAIL_GOOGLE_PAY=1
# Apple Pay domain verification file content (from the PayPal dashboard), served under /.well-known
# APPLE_PAY_DOMAIN_ASSOCIATION=
# RAIL_OXXO=1
