{
  "name": "paygent",
  "version": "0.1.0",
  "description": "The AI cashier for street vendors: say the price, the customer taps, your phone says paid.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env.local server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "e2e": "playwright test",
    "ux:audit": "tsx scripts/ux-audit.ts",
    "voice:clips": "tsx scripts/voice-clips.ts",
    "voice:preview": "tsx scripts/voice-preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisAlejandroCR/paygent.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/LuisAlejandroCR/paygent/issues"
  },
  "homepage": "https://github.com/LuisAlejandroCR/paygent#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "ag-grid-community": "^36.2.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "preact": "^11.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
