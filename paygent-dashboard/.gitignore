# .gitignore: files git skips in the dashboard: deps, build output, editor files and the
# local UX audit output (screenshots and reports from scripts/ux-audit.ts).

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo

# UX audit output (scripts/ux-audit.ts)
ux-audit/

# Vercel: project link, the nitro vercel preset's build output and the CLI's .env.local
.vercel
.env*.local
