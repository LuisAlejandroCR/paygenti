# .gitignore: keeps secrets, dependencies and build output out of the repo.
# Sandbox keys are still keys: they live in .env.local, never in Git.
.env
.env.*
!.env.example
node_modules/
dist/
build/
.next/
.expo/
*.log
.DS_Store
AGENTS.md
CLAUDE.md
.claude/
coverage/
test-results/
playwright-report/
blob-report/
.playwright-cli/
# Lovable-synced design reference: a separate project, never committed here.
lovable/

# Real bank receipts (PII); tests use fictional samples
*.pdf

# UX audit output (npm run ux:audit): screenshots and report, regenerated on every run
ux-shots/

# Voice box Wi-Fi and server settings (firmware/voice-box/secrets.example.h is the template).
firmware/voice-box/secrets.h

# Raw landing recordings (npm run landing:record); the mp4s land in web/public/media/
landing-raw/
