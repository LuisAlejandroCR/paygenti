# .gitignore: keeps secrets, dependencies and build output out of the repo.
# Sandbox keys are still keys: they live in .env.local, never in Git.
.env
.env.*
!.env.example
node_modules/
dist/
build/
.next/
.expo/
*.log
.DS_Store
AGENTS.md
CLAUDE.md
.claude/
coverage/
test-results/
playwright-report/
blob-report/
.playwright-cli/
